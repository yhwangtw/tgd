#!/usr/bin/env bash
# tGD CLI — thin wrapper around setup.sh
# Installed to ~/.local/bin/tgd

set -e

# Resolve the real script path (follow symlinks)
REAL_SCRIPT="$0"
while [[ -L "$REAL_SCRIPT" ]]; do
    LINK_DIR="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)"
    REAL_SCRIPT="$(readlink "$REAL_SCRIPT")"
    [[ "$REAL_SCRIPT" != /* ]] && REAL_SCRIPT="$LINK_DIR/$REAL_SCRIPT"
done
SCRIPT_DIR="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)"

# tGD repo is one level up from bin/
TGD_REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if [[ ! -f "$TGD_REPO_ROOT/setup.sh" ]]; then
    echo "❌ Cannot find tGD installation. Run setup.sh first."
    exit 1
fi

# Dispatch
case "${1:-}" in
    --version|-v)
        exec bash "$TGD_REPO_ROOT/setup.sh" --version "${@:2}"
        ;;
    --upgrade|-u)
        exec bash "$TGD_REPO_ROOT/setup.sh" --upgrade "${@:2}"
        ;;
    --uninstall|--remove)
        exec bash "$TGD_REPO_ROOT/setup.sh" --uninstall "${@:2}"
        ;;
    --release)
        # Prepare-only: writes VERSION + CHANGELOG and pushes; CI publishes.
        # No gh CLI needed locally.
        exec bash "$TGD_REPO_ROOT/scripts/release.sh" "${@:2}"
        ;;
    --help|-h)
        if [[ "$#" -ne 1 ]]; then
            echo "Unknown option after $1: ${2}"
            echo "Run 'tgd --help' for usage."
            exit 1
        fi
        echo "tGD — Make your agent great again."
        echo ""
        echo "Usage: tgd [command]"
        echo ""
        echo "Commands:"
        echo "  (none)         Install or refresh tGD"
        echo "  --upgrade, -u  Force refresh symlinks and hooks"
        echo "  --uninstall    Remove only tGD-managed links and hooks"
        echo "  --version, -v  Show current version"
        echo "  --release      Prepare a release: VERSION + CHANGELOG, commit, push (CI publishes)"
        echo "  --help, -h     Show this help"
        ;;
    "")
        exec bash "$TGD_REPO_ROOT/setup.sh"
        ;;
    *)
        echo "Unknown command: $1"
        echo "Run 'tgd --help' for usage."
        exit 1
        ;;
esac
